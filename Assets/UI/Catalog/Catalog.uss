:root {
  --blue: #286892;
  --navy: #172033;
  --muted: #687386;
  --page: #f4f6f8;
  --border: #dce3e9;
  --pale-blue: #eaf3f8;
}
.screen { position: relative; flex-grow: 1; flex-shrink: 1; min-height: 0; background-color: var(--page); color: var(--navy); }
.header { height: 112px; min-height: 112px; flex-direction: row; align-items: center; padding-left: 18px; padding-right: 18px; background-color: var(--blue); }
.icon-button { width: 48px; height: 48px; margin-right: 12px; border-width: 0; border-radius: 24px; background-color: rgba(255,255,255,0.16); color: white; font-size: 34px; }
.header-copy { flex-grow: 1; }
.header-title { color: white; font-size: 23px; -unity-font-style: bold; }
.header-subtitle { margin-top: 3px; color: rgba(255,255,255,0.82); font-size: 13px; }
.content { flex-grow: 1; flex-shrink: 1; min-height: 0; padding: 0 16px 14px; }
.card { margin-bottom: 12px; padding: 16px; border-width: 1px; border-color: var(--border); border-radius: 16px; background-color: white; }
.preview-container { flex-shrink: 0; padding: 12px 16px 0; }
.preview-card { padding: 10px; }
.preview-heading { flex-direction: row; align-items: center; justify-content: space-between; }
.eyebrow { color: var(--blue); font-size: 12px; -unity-font-style: bold; }
.preview-toggle { min-height: 40px; padding: 0 12px; border-width: 0; background-color: transparent; color: var(--blue); font-size: 13px; }
.preview-image { height: 220px; margin-top: 6px; background-color: #e9eef2; border-radius: 12px; }
.section-title { margin-bottom: 12px; color: var(--navy); font-size: 17px; -unity-font-style: bold; }
.field-title { margin-top: 14px; margin-bottom: 8px; color: var(--muted); font-size: 13px; -unity-font-style: bold; }
.row { flex-direction: row; align-items: center; }
.dimension-field { flex-grow: 1; margin-right: 8px; }
.dimension-field .unity-base-text-field__input, .search-field .unity-base-text-field__input, .spacing-field .unity-base-text-field__input { min-height: 42px; padding-left: 10px; border-width: 1px; border-color: var(--border); border-radius: 10px; background-color: #fbfcfd; color: var(--navy); }
.dimension-field .unity-base-field__label, .search-field .unity-base-field__label, .spacing-field .unity-base-field__label { color: var(--muted); font-size: 12px; }
.choice-button { flex-grow: 1; min-height: 44px; margin-right: 7px; border-width: 1px; border-color: var(--border); border-radius: 10px; background-color: white; color: var(--navy); font-size: 13px; }
.choice-button.selected { border-color: var(--blue); background-color: var(--pale-blue); color: var(--blue); -unity-font-style: bold; }
.style-grid { flex-direction: row; flex-wrap: wrap; }
.style-grid .choice-button { flex-grow: 1; width: 45%; margin-bottom: 7px; }
.layer-card { padding-bottom: 12px; }
.layer-tabs-row { flex-direction: row; align-items: center; }
.layer-tabs-scroll { flex-grow: 1; height: 48px; margin-right: 8px; }
.layer-tabs { flex-direction: row; align-items: center; }
.layer-tab-item { flex-direction: row; align-items: center; margin-right: 7px; }
.layer-tab { min-width: 72px; height: 40px; padding-left: 12px; padding-right: 12px; border-width: 1px; border-color: var(--border); border-top-left-radius: 10px; border-bottom-left-radius: 10px; background-color: #f7f9fa; color: var(--muted); font-size: 13px; }
.layer-tab.selected { border-color: var(--blue); background-color: var(--pale-blue); color: var(--blue); -unity-font-style: bold; }
.layer-remove-button { width: 34px; min-width: 34px; height: 40px; padding-left: 0; padding-right: 0; border-width: 1px; border-left-width: 0; border-color: var(--border); border-top-right-radius: 10px; border-bottom-right-radius: 10px; background-color: #f7f9fa; color: var(--muted); font-size: 18px; }
.layer-remove-button:disabled { color: #aab2bc; }
.add-layer-button { width: 42px; min-width: 42px; height: 40px; padding-left: 0; padding-right: 0; border-width: 1px; border-color: var(--blue); border-radius: 10px; background-color: var(--pale-blue); color: var(--blue); font-size: 23px; -unity-font-style: bold; }
.spacing-field { margin-top: 10px; }
.support-count-row { margin-top: 8px; }
.help-text { margin-top: 10px; color: var(--muted); font-size: 13px; white-space: normal; }
.hidden { display: none; }
.selected-fabric-button { min-height: 82px; padding: 8px; flex-direction: row; align-items: center; border-width: 1px; border-color: var(--border); border-radius: 12px; background-color: #fbfcfd; color: var(--navy); }
.selected-fabric-swatch { width: 76px; height: 64px; margin-right: 12px; border-radius: 8px; background-color: #e9e5dd; }
.selected-fabric-copy { flex-grow: 1; align-items: flex-start; }
.selected-fabric-eyebrow { margin-bottom: 4px; color: var(--muted); font-size: 10px; -unity-font-style: bold; }
.selected-fabric-name { color: var(--navy); font-size: 13px; white-space: normal; }
.selected-fabric-action { margin-left: 8px; color: var(--blue); font-size: 12px; -unity-font-style: bold; }
.material-picker { position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: none; align-items: center; justify-content: center; padding: 18px; background-color: rgba(18,29,42,0.52); }
.material-picker.open { display: flex; }
.material-dialog { width: 100%; max-height: 88%; padding: 16px; border-radius: 16px; background-color: white; }
.material-picker-header { flex-direction: row; align-items: center; margin-bottom: 14px; }
.material-picker-copy { flex-grow: 1; }
.material-picker-title { color: var(--navy); font-size: 18px; -unity-font-style: bold; }
.material-picker-subtitle { margin-top: 3px; color: var(--muted); font-size: 12px; white-space: normal; }
.close-picker-button { width: 38px; min-width: 38px; height: 38px; margin-left: 8px; border-width: 0; border-radius: 19px; background-color: var(--page); color: var(--muted); font-size: 24px; }
.search-field { margin-bottom: 12px; }
.material-scroll { flex-grow: 1; min-height: 300px; }
.material-scroll .unity-scroll-view__vertical-scroller { display: none; }
.material-grid { flex-direction: row; flex-wrap: wrap; }
.material-choice { width: 48%; min-height: 138px; margin: 0 2% 10px 0; padding: 8px; flex-direction: column; align-items: stretch; border-width: 1px; border-color: var(--border); border-radius: 12px; background-color: #fbfcfd; color: var(--navy); font-size: 13px; white-space: normal; }
.material-choice.selected { border-width: 2px; border-color: var(--blue); background-color: var(--pale-blue); }
.material-swatch { width: 100%; height: 92px; margin-bottom: 7px; border-radius: 8px; }
.material-name { white-space: normal; -unity-text-align: middle-center; }
.material-empty { margin: 12px 4px; color: var(--muted); font-size: 13px; }
.custom-card { padding-bottom: 18px; }
.slider-label { margin-top: 7px; color: var(--muted); font-size: 12px; }
.config-slider { height: 28px; margin-bottom: 2px; }
.config-slider .unity-base-slider__tracker { height: 5px; border-radius: 3px; background-color: var(--border); }
.config-slider .unity-base-slider__dragger { width: 20px; height: 20px; border-width: 2px; border-color: white; border-radius: 10px; background-color: var(--blue); }
.status-label { margin: 0 4px 12px; color: #b44747; font-size: 13px; white-space: normal; }
.footer { flex-shrink: 0; padding: 10px 16px 16px; border-top-width: 1px; border-top-color: var(--border); background-color: white; }
.selection-summary { margin-bottom: 8px; color: var(--muted); font-size: 12px; white-space: normal; }
.primary-button { min-height: 48px; border-width: 0; border-radius: 13px; background-color: var(--blue); color: white; font-size: 16px; -unity-font-style: bold; }
